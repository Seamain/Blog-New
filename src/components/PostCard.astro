---
import formatDate from "../libs/formatDate";
import pagePath from "../libs/pagePath";
import { Icon } from "astro-icon/components";
import type Post from "../interfaces/Post";
import { fetchAvatarAsDataUrl } from "../libs/fetchAvatar";

interface Props {
  post: Post;
  ml?: string;
  /** Heading level for the post title, so each page keeps a correct outline. */
  headingLevel?: 2 | 3;
}

const { post, ml, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const avatarRawUrl = post.author?.avatar?.formats?.thumbnail?.url ?? null;
// Fetch avatar at build time with CF Access credentials so the browser can render it
const avatarUrl = await fetchAvatarAsDataUrl(avatarRawUrl);
const createdAt = new Date(post.createdAt);
const formatedTime = formatDate(createdAt, "yyyy-MM-dd");
const tags = post.tags ?? [];
const titleId = `post-card-${post.slug}`;
---

<article
  class={`post-card acg-card group relative overflow-hidden rounded-2xl transition-[translate,border-color,box-shadow] duration-300 hover:-translate-y-1 w-full ${ml ?? ""}`}
>
  <!-- Corner bracket decorations -->
  <div class="absolute top-3 left-3 w-4 h-4 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true">
    <div class="absolute top-0 left-0 w-3 h-3" style="border-top: 1.5px solid #FF6B9D; border-left: 1.5px solid #FF6B9D; border-radius: 2px 0 0 0;"></div>
  </div>
  <div class="absolute top-3 right-3 w-4 h-4 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true">
    <div class="absolute top-0 right-0 w-3 h-3" style="border-top: 1.5px solid #8B5CF6; border-right: 1.5px solid #8B5CF6; border-radius: 0 2px 0 0;"></div>
  </div>
  <div class="absolute bottom-3 left-3 w-4 h-4 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true">
    <div class="absolute bottom-0 left-0 w-3 h-3" style="border-bottom: 1.5px solid #8B5CF6; border-left: 1.5px solid #8B5CF6; border-radius: 0 0 0 2px;"></div>
  </div>
  <div class="absolute bottom-3 right-3 w-4 h-4 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true">
    <div class="absolute bottom-0 right-0 w-3 h-3" style="border-bottom: 1.5px solid #FF6B9D; border-right: 1.5px solid #FF6B9D; border-radius: 0 0 2px 0;"></div>
  </div>

  <!-- Hover glow effect -->
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="background: linear-gradient(135deg, rgba(255,107,157,0.05) 0%, rgba(139,92,246,0.05) 100%);"></div>

  <a href={pagePath(`/posts/${post.slug}`)} aria-labelledby={titleId} class="relative flex h-full flex-col gap-4 rounded-2xl px-4 py-5 sm:px-6 sm:py-6">
    <!-- Author + date row -->
    <header class="flex items-center justify-between gap-3 text-sm">
      <div class="flex items-center gap-2.5 min-w-0">
        {avatarUrl ? (
          <img
            src={avatarUrl}
            class="h-9 w-9 sm:h-10 sm:w-10 rounded-full object-cover shrink-0"
            style="border: 1.5px solid rgba(255,107,157,0.5);"
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            alt=""
          />
        ) : (
          <div class="card-avatar-fallback flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full text-xs font-bold uppercase" aria-hidden="true">
            {post.author?.name?.slice(0, 1) ?? "S"}
          </div>
        )}
        <div class="min-w-0">
          {post.author?.name && <p class="card-author truncate text-sm font-semibold">{post.author.name}</p>}
          <p class="card-meta flex items-center gap-1 text-xs">
            <Icon class="h-3 w-3 shrink-0" name="Clock" aria-hidden="true" />
            <time class="truncate tabular-nums" datetime={createdAt.toISOString()}>{formatedTime}</time>
            {post.category?.name && (
              <span class="truncate">· {post.category.name}</span>
            )}
          </p>
        </div>
      </div>
      <!-- Tags: 1 on mobile, 2 on larger screens -->
      {tags.length > 0 && (
        <ul class="flex shrink-0 flex-wrap items-center justify-end gap-1.5" aria-label="标签">
          {tags.slice(0, 2).map((tag, index) => (
            <li class={`acg-tag ${index > 0 ? "hidden sm:inline-flex" : "inline-flex"}`}>{tag.name}</li>
          ))}
          {tags.length > 2 && (
            <li class="card-meta hidden sm:inline text-xs">+{tags.length - 2}</li>
          )}
        </ul>
      )}
    </header>

    <div class="flex-1">
      <Heading id={titleId} class="card-title text-lg sm:text-xl font-bold leading-snug">
        {post.title}
      </Heading>
      {post.summary && (
        <p class="card-summary mt-2 line-clamp-2 sm:line-clamp-3 text-sm leading-relaxed">
          {post.summary}
        </p>
      )}
    </div>

    <footer class="card-cta flex items-center gap-2 text-sm font-semibold" aria-hidden="true">
      <span>阅读文章</span>
      <svg
        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </footer>
  </a>
</article>

<style>
  .card-title {
    font-family: var(--font-cjk);
    color: var(--text-strong);
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .card-author {
    color: var(--text-body);
  }
  .card-meta {
    color: var(--text-muted);
  }
  .card-summary {
    color: var(--text-muted);
  }
  .card-cta {
    color: var(--ink-sakura);
  }
  .card-avatar-fallback {
    border: 1.5px dashed rgba(255, 107, 157, 0.5);
    color: var(--ink-sakura);
  }
</style>
