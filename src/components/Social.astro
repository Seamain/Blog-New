---
import { Icon } from "astro-icon/components";

const { platform, username } = Astro.props;
---

<a
  class="social-link"
  href={`https://www.${platform}.com/${username}`}
  aria-label={`Seamain 的 ${platform} 主页`}
>
  <Icon class="h-8 w-8" name={platform} aria-hidden="true" />
</a>

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: var(--text-body);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .social-link :global(svg) {
    fill: currentColor;
  }
  .social-link:hover {
    background: rgba(255, 107, 157, 0.1);
    color: var(--ink-sakura);
  }
</style>
