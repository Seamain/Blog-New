---
import { createFullListOfPost, getPost } from "../../api/Post";
import { generateAISummary } from "../../api/AiSummary";
import type Post from "../../interfaces/Post";
import BasicStyle from "../../layouts/BasicStyle.astro";
import formatDate from "../../libs/formatDate";
import pagePath from "../../libs/pagePath";
import { renderMarkdown, excerpt } from "../../libs/renderMarkdown";
import Navbar from "../../components/Navbar.astro";
import AISummary from "../../components/AISummary.astro";
import PostEnd from "../../components/PostEnd.astro";
import type PostLink from "../../interfaces/PostLink";
import { fetchAvatarAsDataUrl } from "../../libs/fetchAvatar";

interface Props {
  post: Post;
  newer: PostLink | null;
  older: PostLink | null;
  related: PostLink[];
}

export async function getStaticPaths() {
  // getStaticPaths runs in its own scope, so helpers must live inside it.
  const toLink = (post: Post): PostLink => ({
    slug: post.slug,
    title: post.title,
    createdAt: post.createdAt,
  });

  try {
    // Newest first, so index - 1 is the newer post and index + 1 the older one.
    const list = await createFullListOfPost();
    const paths = [];

    for (const [index, entry] of list.entries()) {
      try {
        const post = await getPost(entry.documentId);
        const newer = list[index - 1] ? toLink(list[index - 1]) : null;
        const older = list[index + 1] ? toLink(list[index + 1]) : null;
        const neighbours = new Set([newer?.slug, older?.slug, entry.slug]);
        const related = entry.category?.slug
          ? list
              .filter(
                (other) =>
                  other.category?.slug === entry.category?.slug &&
                  !neighbours.has(other.slug),
              )
              .slice(0, 3)
              .map(toLink)
          : [];

        paths.push({
          params: { slug: entry.slug },
          props: { post, newer, older, related },
        });
      } catch (postError) {
        console.error(
          `Failed to load post ${entry.documentId}:`,
          postError instanceof Error ? postError.message : String(postError),
        );
      }
    }

    return paths;
  } catch (error) {
    console.error(
      "Failed to generate static paths:",
      error instanceof Error ? error.message : String(error),
    );
    return [];
  }
}

const { post, newer, older, related } = Astro.props;
const authorName = post.author?.name;
const avatarRawUrl = post.author?.avatar?.formats?.thumbnail?.url ?? null;
// Fetch avatar at build time with CF Access credentials so the browser can render it
const avatarUrl = await fetchAvatarAsDataUrl(avatarRawUrl);
const publishedTime = new Date(Date.parse(post.createdAt));
const formattedTime = formatDate(publishedTime, "yyyy-MM-dd");
const html = renderMarkdown(post.content);
const dek = post.summary?.trim() ?? "";

// Not awaited here: AISummary awaits it while the rest of the page streams,
// so the AI call runs alongside the navbar fetch instead of blocking the head.
const aiSummary = generateAISummary(post.content, post.title)
  .then((summary) => summary?.trim() ?? "")
  .catch((error) => {
    console.error("Failed to generate AI summary:", error);
    return "";
  });

const description = dek || excerpt(post.content);
---

<BasicStyle
  title={post.title}
  description={description}
  ogImage={"/posts/" + post.slug + ".png"}
  author={authorName}
  publishedTime={publishedTime}
>
  <Navbar />
  <div class="flex w-full flex-col items-center px-3 sm:px-6">
    <article id="content" tabindex="-1" class="reading-sheet outline-none mt-4 mb-6 w-full max-w-3xl rounded-2xl px-5 pt-7 pb-8 sm:mt-10 sm:px-12 sm:pt-12 sm:pb-12">
      <header class="post-header">
        <h1 class="post-title">{post.title}</h1>
        {dek && <p class="post-dek">{dek}</p>}

        <div class="post-meta">
          {authorName && (
            <span class="post-meta-item">
              {avatarUrl ? (
                <img
                  src={avatarUrl}
                  class="post-avatar"
                  width="28"
                  height="28"
                  decoding="async"
                  alt=""
                />
              ) : (
                <span class="post-avatar post-avatar-fallback" aria-hidden="true">
                  {authorName.slice(0, 1)}
                </span>
              )}
              <span class="font-semibold" style="color: var(--text-strong);">{authorName}</span>
            </span>
          )}
          <time class="post-meta-item" datetime={publishedTime.toISOString()}>
            {formattedTime}
          </time>
          {post.category?.slug && post.category?.name && (
            <a class="post-meta-item post-category" href={pagePath(`/categories/${post.category.slug}`)}>
              {post.category.name}
            </a>
          )}
        </div>
      </header>

      <AISummary summary={aiSummary} />

      <div class="post-body" set:html={html} />

      <PostEnd
        tags={post.tags ?? []}
        authorName={authorName}
        avatarUrl={avatarUrl}
        category={post.category?.slug ? post.category : undefined}
        newer={newer}
        older={older}
        related={related}
      />
    </article>
  </div>
</BasicStyle>

<style>
  .post-title {
    font-family: var(--font-cjk);
    font-size: 1.625rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--text-strong);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .post-dek {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .post-meta {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .post-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .post-meta-item + .post-meta-item::before {
    content: "·";
    margin: 0 0.6rem;
    color: var(--text-muted);
  }

  time.post-meta-item {
    font-variant-numeric: tabular-nums;
  }

  .post-avatar {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    object-fit: cover;
    border: 1.5px solid rgba(255, 107, 157, 0.45);
  }

  .post-avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-sakura);
    border-style: dashed;
  }

  .post-category {
    color: var(--ink-sakura);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.15s ease;
  }

  .post-category:hover {
    text-decoration-color: currentColor;
  }

  .post-body {
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .post-title {
      font-size: 2.125rem;
      line-height: 1.25;
    }

    .post-dek {
      font-size: 1.0625rem;
    }

    .post-body {
      margin-top: 2.5rem;
    }
  }
</style>
